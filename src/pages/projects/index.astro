---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { PROJECT_CATEGORIES } from '../../consts';

const projects = (await getCollection('projects'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Group order comes from PROJECT_CATEGORIES in consts.ts. Within a group,
// newest first. Empty groups drop out so an unused category never renders
// as a bare heading.
const groups = PROJECT_CATEGORIES.map((category) => ({
    ...category,
    items: projects.filter((p) => p.data.category === category.id),
})).filter((group) => group.items.length > 0);
---

<BaseLayout title="Projects" description="Projects I've worked on, both CTF-related and otherwise." width={1100} pad="4em 2em">
    <h1>Projects</h1>

    {groups.map((group) => (
        <section class="group">
            <div class="group-head">
                <h2 class="group-title">{group.label}</h2>
                <p class="group-blurb">{group.blurb}</p>
            </div>

            <div class="grid">
                {group.items.map((project) => (
                    <a href={`/projects/${project.id}/`} class="card project-card">
                        <div class="project-left">
                            <h3 class="title">{project.data.title}</h3>
                            <span class="date"><FormattedDate date={project.data.pubDate} /></span>
                        </div>
                        <div class="project-right">
                            <p class="description">{project.data.description}</p>
                            <div class="stack">
                                {project.data.stack?.map((tag) => (
                                    <span class={`tag tag-${tag.toLowerCase().replace(/\s+/g, '-')}`}>{tag}</span>
                                ))}
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    ))}

    <style>

        h1 {
            color: var(--accent);
            margin-bottom: var(--space-12);
        }

        .group {
            margin-bottom: var(--space-16);
        }

        .group-head {
            margin-bottom: var(--space-6);
            padding-bottom: var(--space-3);
            border-bottom: 1px solid var(--border);
        }

        .group-title {
            font-size: 1.6rem;
            margin: 0;
            color: var(--accent);
        }

        .group-blurb {
            margin: var(--space-1) 0 0 0;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

		.project-card {
			display: grid;
			grid-template-columns: 200px 1fr;
			align-items: center;
			padding: var(--space-6);
			gap: var(--space-6);
		}

		.project-left {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}

		.project-right {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.description {
			font-size: 0.9rem;
			color: var(--text-muted);
			margin: 0;
		}

		.stack {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.tag {
			font-size: 0.7rem;
			padding: 0.15em 0.7em;
			border: 1px solid currentColor;
			border-radius: 999px;
			opacity: 0.85;
			white-space: nowrap;
		}

		@media (max-width: 720px) {
			.project-card { grid-template-columns: 1fr; gap: var(--space-3); }
		}

    </style>

</BaseLayout>
